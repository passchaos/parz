-        pub fn deinit(self: *Self) void {
-            if (self.started) {
-                self.mutex.lockUncancelable(self.io);
-                self.is_stopping.store(true, .release);
-                self.job_ready.broadcast(self.io);
-                self.heartbeat_ready.broadcast(self.io);
-                self.mutex.unlock(self.io);
