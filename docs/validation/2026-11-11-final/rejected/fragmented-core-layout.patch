-                job.pushShared(&owner.shared_tail);
-                shared += 1;
-            }
-            if (shared != 0) self.ready_owners.push(owner.index);
-
-            var i: usize = 0;
-            while (i < shared) : (i += 1) {
-                self.job_ready.signal(self.io);
-            }
