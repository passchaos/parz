+test "job list: deferred links preserve mixed local and shared FIFO order" {
+    var sentinel = Job.head();
+    var tail: *Job = &sentinel;
+    var shared = Job.head();
+    var shared_tail: *Job = &shared;
+    var jobs: [32]Job = undefined;
+    var busy: [32]bool = @splat(false);
+    var local_order: [32]usize = undefined;
+    var shared_order: [32]usize = undefined;
+    var local_count: usize = 0;
+    var shared_count: usize = 0;
+    var random = std.Random.DefaultPrng.init(0xdefe77ed);
+    var state = ExecuteState{ .io = std.testing.io };
+    for (0..3000) |_| {
+        const operation = random.random().uintLessThan(usize, 5);
+        if (operation == 0 and local_count + shared_count < jobs.len) {
+            const id = std.mem.indexOfScalar(bool, &busy, false).?;
+            jobs[id] = Job.pending();
+            jobs[id].pushLocal(&tail, noop);
+            busy[id] = true;
+            local_order[local_count] = id;
+            local_count += 1;
+        } else if (operation == 1 and local_count > 0) {
+            const id = local_order[local_count - 1];
+            const prev = if (local_count == 1) &sentinel else &jobs[local_order[local_count - 2]];
+            jobs[id].popLocalTail(&tail, prev);
+            local_count -= 1;
+            busy[id] = false;
+        } else if (operation == 2 and local_count > 1) {
+            const index = random.random().uintLessThan(usize, local_count - 1);
+            const id = local_order[index];
+            Job.prepareLocal(&sentinel, tail);
+            try std.testing.expectEqual(local_count, count(&sentinel));
+            jobs[id].removeLocalPrepared(tail);
+            local_count -= 1;
+            std.mem.copyForwards(usize, local_order[index..local_count], local_order[index + 1 ..][0 .. local_count - index]);
+            busy[id] = false;
+        } else if (operation == 3 and local_count > 1) {
+            Job.prepareLocal(&sentinel, tail);
+            const offered = sentinel.shift().?;
+            try std.testing.expectEqual(&jobs[local_order[0]], offered);
+            offered.pushShared(&shared_tail);
+            shared_order[shared_count] = local_order[0];
+            shared_count += 1;
+            local_count -= 1;
+            std.mem.copyForwards(usize, local_order[0..local_count], local_order[1..][0..local_count]);
+        } else if (operation == 4 and shared_count > 0) {
+            const job = Job.popHead(&shared, &shared_tail).?;
+            try std.testing.expectEqual(&jobs[shared_order[0]], job);
+            job.setExecuteState(&state);
+            try std.testing.expectEqual(JobState.executing, job.state());
+            try std.testing.expectEqual(&state, job.getExecuteState());
+            busy[shared_order[0]] = false;
+            shared_count -= 1;
+            std.mem.copyForwards(usize, shared_order[0..shared_count], shared_order[1..][0..shared_count]);
+        }
+        var cursor = tail;
+        var remaining = local_count;
+        while (remaining > 0) {
+            remaining -= 1;
+            try std.testing.expectEqual(&jobs[local_order[remaining]], cursor);
+            try std.testing.expectEqual(JobState.queued_local, cursor.state());
+            cursor = @ptrCast(@alignCast(cursor.prev_or_null.?));
+        }
+        try std.testing.expectEqual(&sentinel, cursor);
+        try std.testing.expectEqual(shared_count, count(&shared));
+        if (local_count == 0) try std.testing.expect(sentinel.isTail());
+    }
+    Job.prepareLocal(&sentinel, tail);
+    try std.testing.expectEqual(local_count, count(&sentinel));
+    while (local_count > 0) {
+        const id = local_order[local_count - 1];
+        const prev = if (local_count == 1) &sentinel else &jobs[local_order[local_count - 2]];
+        jobs[id].popLocalTail(&tail, prev);
+        local_count -= 1;
+    }
+    try std.testing.expectEqual(&sentinel, tail);
+    try std.testing.expect(sentinel.isTail());
+}
