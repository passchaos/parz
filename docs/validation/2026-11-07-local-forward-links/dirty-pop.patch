+    /// Owner-only append. Forward links are built only when sharing or a
+    /// non-tail join needs them; recursive local forks never write the prior
+    /// tail. No atomics, locks or allocation occur here.
+    pub inline fn pushLocal(self: *Job, tail: **Job, handler: Handler) void {
+        std.debug.assert(self.handler == null);
+        const prev = tail.*;
+        self.handler = handler;
+        self.prev_or_null = @ptrCast(prev);
+        self.next_or_null = local_dirty;
+        tail.* = self;
+    }
+
+    /// Materialize forward links once per unchanged local list. The caller
+    /// owns every node. Sharing retains the local tail, so it also retains
+    /// this cache marker; prepared non-tail removals keep the cache valid.
+    pub fn prepareLocal(sentinel: *Job, tail: *Job) void {
+        if (tail == sentinel) {
+            sentinel.next_or_null = null;
+            return;
+        }
+        if (tail.next_or_null != local_dirty) {
+            std.debug.assert(tail.next_or_null == null);
+            return;
+        }
+        var next: ?*anyopaque = null;
+        var job = tail;
+        while (job != sentinel) {
+            std.debug.assert(job.handler != null);
+            const prev: *Job = @ptrCast(@alignCast(job.prev_or_null.?));
+            job.next_or_null = next;
+            next = @ptrCast(job);
+            job = prev;
+        }
+        sentinel.next_or_null = next;
+    }
+
+    /// Owner-only tail removal. Invalidate cached forward links on the new
+    /// tail, keeping recursive joins constant-time and free of atomics.
+    pub inline fn popLocalTail(self: *Job, tail: **Job, prev: *Job) void {
+        std.debug.assert(self.handler != null);
+        std.debug.assert(tail.* == self);
+        std.debug.assert(self.prev_or_null == @as(?*anyopaque, @ptrCast(prev)));
+        std.debug.assert(self.next_or_null == local_dirty or self.next_or_null == null);
+        prev.next_or_null = local_dirty;
+        tail.* = prev;
+    }
+
+    /// Remove a non-tail local node after prepareLocal. Successive ordered
+    /// joins remain constant-time until another push or tail pop invalidates
+    /// the forward links. Shared nodes continue to use remove under the mutex.
+    pub fn removeLocalPrepared(self: *Job, tail: *Job) void {
+        std.debug.assert(self.handler != null);
+        std.debug.assert(tail != self and tail.next_or_null == null);
+        const prev: *Job = @ptrCast(@alignCast(self.prev_or_null.?));
+        const next: *Job = @ptrCast(@alignCast(self.next_or_null.?));
+        prev.next_or_null = @ptrCast(next);
+        next.prev_or_null = @ptrCast(prev);
